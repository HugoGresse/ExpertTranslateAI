{
  "name": "@experttranslate/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "HTTP server that runs the ExpertTranslateAI engine with a server-held OpenRouter key and streams progress over SSE.",
  "bin": {
    "eta-server": "./bin/eta-server.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node bin/eta-server.ts"
  },
  "dependencies": {
    "@experttranslate/core": "*",
    "@experttranslate/node": "*"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
