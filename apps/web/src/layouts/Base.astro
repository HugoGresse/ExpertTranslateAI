---
import '../styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const links = [
  { href: `${base}/`, label: 'Translate' },
  { href: `${base}/context`, label: 'Context' },
  { href: `${base}/guidelines`, label: 'Guidelines' },
  { href: `${base}/glossary`, label: 'Glossary' },
  { href: `${base}/memory`, label: 'Memory' },
  { href: `${base}/insights`, label: 'Insights' },
  { href: `${base}/history`, label: 'History' },
  { href: `${base}/prompts`, label: 'Prompts' },
  { href: `${base}/settings`, label: 'Settings' },
  { href: `${base}/about`, label: 'About' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ExpertTranslateAI</title>
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#2f6df6" />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-neutral-200 bg-white">
      <nav class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3">
        <a href={`${base}/`} class="font-semibold tracking-tight">
          ExpertTranslateAI
        </a>
        <ul class="flex gap-4 text-sm">
          {links.map((l) => (
            <li>
              <a href={l.href} class="hover:text-accent">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>
    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        navigator.serviceWorker.register(`${base}/sw.js`, { scope: `${base}/` }).catch(() => undefined)
      }
    </script>
  </body>
</html>
