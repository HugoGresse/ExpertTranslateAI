---
import '../styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const links = [
  { href: `${base}/`, label: 'Translate' },
  { href: `${base}/context`, label: 'Context' },
  { href: `${base}/guidelines`, label: 'Guidelines' },
  { href: `${base}/glossary`, label: 'Glossary' },
  { href: `${base}/memory`, label: 'Memory' },
  { href: `${base}/insights`, label: 'Insights' },
  { href: `${base}/history`, label: 'History' },
  { href: `${base}/prompts`, label: 'Prompts' },
  { href: `${base}/settings`, label: 'Settings' },
  { href: `${base}/about`, label: 'About' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ExpertTranslateAI</title>
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#3182f6" />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-line bg-canvas">
      <nav class="mx-auto flex max-w-[1440px] flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3">
        <a href={`${base}/`} class="text-[17px] font-bold tracking-tight text-fg">
          ExpertTranslateAI
        </a>
        <ul class="flex flex-wrap gap-1 text-sm font-medium">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded-lg px-2.5 py-1.5 text-body hover:bg-neutral-100 hover:text-fg"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main class="mx-auto max-w-[1440px] px-5 py-6">
      <slot />
    </main>
    <script>
      import { registerServiceWorker } from '../lib/registerServiceWorker'
      registerServiceWorker()
    </script>
  </body>
</html>
